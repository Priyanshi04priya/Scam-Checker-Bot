# Copy this file to .env and fill in what you need. Never commit .env.
# Blank values fall back to the defaults in scambot/core/settings.py.

# Runtime: ENVIRONMENT is dev, test or prod; LOG_LEVEL is DEBUG, INFO, WARNING, ERROR or CRITICAL.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Telegram bot token from @BotFather, and the secret Telegram sends with every webhook call.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bot API base URL; change it only for a self-hosted Bot API server or a local test double.
TELEGRAM_API_URL=https://api.telegram.org

# WhatsApp Cloud API: access token, app secret (webhook signatures) and a comma-separated
# list of phone numbers allowed to use the bot, e.g. 919800000001,919800000002.
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWLIST=

# LLM provider key. Without it the bot still works: rule-based checks and fixed explanations.
ANTHROPIC_API_KEY=
# Model, effort (low, medium, high, xhigh or max) and output-token budget per LLM call.
LLM_MODEL_ANALYZE=claude-opus-5-5
LLM_MODEL_SCAM_CLASSIFY=claude-opus-5-5
LLM_MODEL_EXPLANATION=claude-opus-5-5
LLM_MODEL_FACTCHECK_RELEVANCE=claude-opus-5-5
LLM_EFFORT_ANALYZE=low
LLM_EFFORT_SCAM_CLASSIFY=low
LLM_EFFORT_EXPLANATION=low
LLM_EFFORT_FACTCHECK_RELEVANCE=low
LLM_MAX_TOKENS_ANALYZE=8192
LLM_MAX_TOKENS_SCAM_CLASSIFY=8192
LLM_MAX_TOKENS_EXPLANATION=4096
LLM_MAX_TOKENS_FACTCHECK_RELEVANCE=8192
# Request timeout (seconds) and retries for each LLM request.
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
# Let the provider answer with a fallback model when the main model declines a request.
LLM_REFUSAL_FALLBACK=true

# Google Cloud key with Fact Check Tools, Safe Browsing and Vision enabled.
# Fact Check Tools search and Safe Browsing need it; without it claims are matched only
# against the local fact-check index and links are not checked against Safe Browsing.
GOOGLE_API_KEY=

# Sightengine API user and secret.
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Secret used to hash platform user IDs. Required in prod. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
USER_ID_PEPPER=

# Admin dashboard login: username and a password hash.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Connection URLs. The defaults match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://scambot:scambot@localhost:5432/scambot
REDIS_URL=redis://localhost:6379/0

# Checker server: the URL the worker calls, the address the server binds to, and the
# comma-separated Host header values the server accepts (port may be *).
MCP_URL=http://localhost:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# Follow shortened links (bit.ly and similar) to see where they lead. Only shortener hosts
# are ever requested.
EXPAND_SHORT_URLS=true

# Sentence-embedding model for the fact-check index. It is downloaded on first start and
# needs the optional embeddings dependencies (uv sync --group embeddings).
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Media: scratch directory for downloaded files (deleted after each job), the OCR engine
# (tesseract or none) and the speech-to-text engine (faster_whisper or none). Speech-to-text
# and statistical language detection need `uv sync --group media`; OCR and video frames need
# the system packages ffmpeg and tesseract-ocr (with the eng and hin language data).
MEDIA_DIR=
OCR_ENGINE=tesseract
STT_ENGINE=faster_whisper
# Whisper model size, numeric precision and CPU threads (0 lets the library choose).
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=0

# Used only by docker compose for the local Postgres container.
POSTGRES_USER=scambot
POSTGRES_PASSWORD=scambot
POSTGRES_DB=scambot

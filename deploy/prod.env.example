# Production settings for the one-VM deployment. On the VM: cp deploy/prod.env.example .env
# && chmod 600 .env, then fill in the blanks. Never commit .env. Full steps: deploy/README.md.
# docker-compose.yml sets DATABASE_URL, REDIS_URL and the checker-server settings itself.

# Public host name (an A record must point at the VM) and the address for certificate notices.
DOMAIN=
ACME_EMAIL=
# Networks (space-separated CIDRs, e.g. "203.0.113.5/32 10.0.0.0/8"; no commas) allowed to open /admin. The default allows nobody remote.
ADMIN_ALLOW_CIDRS=127.0.0.1/32

# Database password for the Postgres container. Must be URL-safe (it is embedded in DATABASE_URL); generate: openssl rand -hex 24
POSTGRES_USER=scambot
POSTGRES_PASSWORD=

# Redis password. Must be URL-safe (it is embedded in REDIS_URL); generate: openssl rand -hex 24
REDIS_PASSWORD=
POSTGRES_DB=scambot

# Daily database backup (UTC time of day, days to keep).
BACKUP_AT_UTC=21:30
BACKUP_KEEP_DAYS=14

# Resource limits per container (defaults suit a 16-24 GB VM; on 8 GB use
# WORKER_MEM_LIMIT=2g MCP_MEM_LIMIT=2g POSTGRES_MEM_LIMIT=768m and WHISPER_MODEL=base).
POSTGRES_MEM_LIMIT=1g
MCP_MEM_LIMIT=3g
MCP_CPUS=1.5
WORKER_MEM_LIMIT=4g
WORKER_CPUS=2.0

# Build argument for the image (add --group voice to enable the local voice model, and then
# set VOICE_BACKEND=huggingface below).
# UV_GROUPS=--group embeddings --group media --group c2pa


# Runtime: ENVIRONMENT is dev, test or prod; LOG_LEVEL is DEBUG, INFO, WARNING, ERROR or CRITICAL.
ENVIRONMENT=prod
LOG_LEVEL=INFO

# Telegram bot token from @BotFather, and the secret Telegram sends with every webhook call.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bot API base URL; change it only for a self-hosted Bot API server or a local test double.
TELEGRAM_API_URL=https://api.telegram.org

# WhatsApp Cloud API (optional demo). It is on when the token and the phone number ID are set.
# System-user access token (a dashboard temporary token expires after about 24 hours).
WHATSAPP_TOKEN=
# App secret from App settings -> Basic; every webhook call is verified with it. Required when on.
WHATSAPP_APP_SECRET=
# Any random string; type the same value into the webhook settings of the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# Phone number ID shown under API Setup (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Phone numbers allowed to use the bot, digits only, comma-separated (a test number allows
# about 5). Empty means nobody is served.
WHATSAPP_ALLOWLIST=
# Graph API version; use the newest one shown in the Meta app dashboard.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_GRAPH_URL=https://graph.facebook.com
# Show the typing indicator and read receipt while a check runs.
WHATSAPP_MARK_READ=true

# LLM provider key. Without it the bot still works: rule-based checks and fixed explanations.
ANTHROPIC_API_KEY=
# Model, effort (low, medium, high, xhigh or max) and output-token budget per LLM call.
LLM_MODEL_ANALYZE=claude-opus-5-5
LLM_MODEL_SCAM_CLASSIFY=claude-opus-5-5
LLM_MODEL_EXPLANATION=claude-opus-5-5
LLM_MODEL_FACTCHECK_RELEVANCE=claude-opus-5-5
LLM_MODEL_CAPTION_COMPARE=claude-opus-5-5
LLM_EFFORT_ANALYZE=low
LLM_EFFORT_SCAM_CLASSIFY=low
LLM_EFFORT_EXPLANATION=low
LLM_EFFORT_FACTCHECK_RELEVANCE=low
LLM_EFFORT_CAPTION_COMPARE=low
LLM_MAX_TOKENS_ANALYZE=8192
LLM_MAX_TOKENS_SCAM_CLASSIFY=8192
LLM_MAX_TOKENS_EXPLANATION=4096
LLM_MAX_TOKENS_FACTCHECK_RELEVANCE=8192
LLM_MAX_TOKENS_CAPTION_COMPARE=8192
# Request timeout (seconds) and retries for each LLM request.
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
# Let the provider answer with a fallback model when the main model declines a request.
LLM_REFUSAL_FALLBACK=true

# Google Cloud key with Fact Check Tools, Safe Browsing and Vision enabled.
# Fact Check Tools search and Safe Browsing need it; without it claims are matched only
# against the local fact-check index and links are not checked against Safe Browsing.
# Vision web detection powers the original-source image search; without the key that check
# is reported as unavailable.
GOOGLE_API_KEY=

# Sightengine API user and secret. They enable AI-image detection; without them that check is
# reported as unavailable.
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Secret used to hash platform user IDs. Required in prod. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
USER_ID_PEPPER=

# Admin dashboard login: username and an argon2 password hash. Leave the hash empty to turn the
# dashboard and /metrics off. Make the hash with:
#   docker compose run --rm api python -m scambot.api.admin.hashpw
# Paste it between single quotes so the $ characters are kept: ADMIN_PASSWORD_HASH='$argon2id$...'
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Telegram chat that receives checker error alerts; empty turns the alerts off.
ADMIN_CHAT_ID=

# Follow shortened links (bit.ly and similar) to see where they lead. Only shortener hosts
# are ever requested.
EXPAND_SHORT_URLS=true

# Sentence-embedding model for the fact-check index. It is downloaded on first start and
# needs the optional embeddings dependencies (uv sync --group embeddings).
EMBEDDING_MODEL=intfloat/multilingual-e5-small

OCR_ENGINE=tesseract
STT_ENGINE=faster_whisper
# Whisper model size, numeric precision and CPU threads (0 lets the library choose).
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=0

# Synthetic-voice check. huggingface runs a local model and needs `uv sync --group voice`
# (for Docker, build with UV_GROUPS="--group embeddings --group media --group c2pa --group voice");
# reality_defender is a hosted service (not usable yet; it would send audio to a third party);
# none switches the check off. The default model is provisional until the comparison in
# README has been run; set VOICE_MODEL_REVISION to a commit hash to pin it.
VOICE_BACKEND=none
VOICE_MODEL_ID=MelodyMachine/Deepfake-audio-detection-V2
VOICE_MODEL_REVISION=
VOICE_CPU_THREADS=0
REALITY_DEFENDER_API_KEY=

# Optional overrides of config/thresholds.yaml (the settings table in the database wins over both):
# checks per user per hour (default 20), and days a finished verdict may be reused (default 7).
RATE_LIMIT_PER_HOUR=
CACHE_WINDOW_DAYS=
